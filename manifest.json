{
  "manifest_version": 3,
  "name": "TorBox Send",
  "version": "1.3.0",
  "description": "Send magnet, .torrent, .nzb and hoster links to your TorBox account.",
  "icons": { "96": "icon.png" },
  "permissions": ["menus", "notifications", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": { "scripts": ["lib.js", "background.js"] },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["lib.js", "content.js"],
      "all_frames": true
    }
  ],
  "action": { "default_icon": "icon.png", "default_title": "TorBox Send", "default_popup": "options.html?popup" },
  "options_ui": { "page": "options.html" },
  "browser_specific_settings": {
    "gecko": {
      "id": "torbox-send@korel",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["authenticationInfo", "websiteContent"]
      }
    }
  }
}
